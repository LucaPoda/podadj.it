---
import { type Locale, switchLocalePath } from '../i18n/ui';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const currentPath = Astro.url.pathname;
const itPath = switchLocalePath(currentPath, 'it');
const enPath = switchLocalePath(currentPath, 'en');
---

<nav aria-label="Language selector" class="inline-flex items-center gap-1 bg-black/60 border border-white/20 backdrop-blur-md rounded-full p-1 text-xs tracking-wider shadow-lg">
  {currentLocale === 'it' ? (
    <span class="px-2.5 py-1 rounded-full font-bold text-white bg-neonPurple/40 border border-neonPurple/50 shadow-[0_0_10px_rgba(168,85,247,0.4)]">
      IT
    </span>
  ) : (
    <a
      href={itPath}
      class="px-2.5 py-1 rounded-full font-medium text-gray-400 hover:text-white hover:bg-white/10 transition-colors"
      title="Versione Italiana"
    >
      IT
    </a>
  )}

  <span class="text-white/30 text-[10px]">|</span>

  {currentLocale === 'en' ? (
    <span class="px-2.5 py-1 rounded-full font-bold text-white bg-neonPurple/40 border border-neonPurple/50 shadow-[0_0_10px_rgba(168,85,247,0.4)]">
      EN
    </span>
  ) : (
    <a
      href={enPath}
      class="px-2.5 py-1 rounded-full font-medium text-gray-400 hover:text-white hover:bg-white/10 transition-colors"
      title="English Version"
    >
      EN
    </a>
  )}
</nav>
