---
import type { LiveSet } from '../data/liveSets';
import { type Locale, useTranslations, getLocalizedPath } from '../i18n/ui';
import MediaEmbed from './MediaEmbed.astro';

interface Props {
  sets: LiveSet[];
  locale: Locale;
  accentColor?: string;
  filterFormat?: 'mainstage' | 'party' | 'groove' | 'other';
  showFormatBadge?: boolean;
}

const {
  sets,
  locale,
  accentColor = '#a855f7',
  filterFormat,
  showFormatBadge = false,
} = Astro.props;

const t = useTranslations(locale);

const filteredSets = filterFormat
  ? sets.filter((s) => s.format === filterFormat)
  : sets;

const sortedSets = [...filteredSets].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

function formatDisplayDate(dateStr: string, currentLocale: Locale): string {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString(currentLocale === 'it' ? 'it-IT' : 'en-US', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}

function getMediaDetails(set: LiveSet) {
  const url = set.mediaUrl || set.mixcloudUrl || set.youtubeUrl || set.soundcloudUrl;
  if (!url) return null;

  let platform: 'mixcloud' | 'youtube' | 'soundcloud' = 'soundcloud';
  if (set.mediaType) {
    platform = set.mediaType;
  } else if (url.includes('mixcloud.com')) {
    platform = 'mixcloud';
  } else if (url.includes('youtube.com') || url.includes('youtu.be')) {
    platform = 'youtube';
  }

  let isEmbeddable = false;
  if (platform === 'mixcloud' && url.includes('mixcloud.com/')) {
    const parts = url.split('mixcloud.com/')[1]?.split('/').filter(Boolean) || [];
    isEmbeddable = parts.length >= 2;
  } else if (platform === 'youtube') {
    isEmbeddable = url.includes('v=') || url.includes('youtu.be/');
  } else if (platform === 'soundcloud' && url.includes('soundcloud.com/')) {
    const parts = url.split('soundcloud.com/')[1]?.split('/').filter(Boolean) || [];
    isEmbeddable = parts.length >= 2;
  }

  const icons = {
    mixcloud: 'fab fa-mixcloud',
    youtube: 'fab fa-youtube',
    soundcloud: 'fab fa-soundcloud',
  };

  const labels = {
    mixcloud: 'Mixcloud',
    youtube: 'YouTube',
    soundcloud: 'SoundCloud',
  };

  return {
    url,
    platform,
    isEmbeddable,
    icon: icons[platform],
    label: labels[platform],
  };
}

const formatBadgeStyles: Record<string, { label: string; class: string }> = {
  mainstage: {
    label: 'Mainstage',
    class: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
  },
  party: {
    label: 'Party',
    class: 'bg-fuchsia-500/15 text-fuchsia-300 border-fuchsia-500/30',
  },
  groove: {
    label: 'Groove',
    class: 'bg-cyan-500/15 text-cyan-300 border-cyan-500/30',
  },
  other: {
    label: 'Eclectic',
    class: 'bg-purple-500/15 text-purple-300 border-purple-500/30',
  },
};
---

<div class="flex flex-col gap-2.5 w-full">
  {sortedSets.length === 0 ? (
    <div class="w-full p-6 rounded-2xl bg-black/40 border border-white/10 text-center text-gray-400 text-xs">
      {t.liveSets.noSetsFound}
    </div>
  ) : (
    sortedSets.map((set) => {
      const eventHref = getLocalizedPath(`/events#${set.eventSlug || set.id}`, locale);
      const badgeInfo = formatBadgeStyles[set.format] || formatBadgeStyles.other;
      const media = getMediaDetails(set);

      return (
        <details class="group rounded-2xl bg-black/40 border border-white/10 hover:border-white/20 transition-all duration-200 overflow-hidden backdrop-blur-md open:bg-black/60 open:border-white/20">
          <summary class="flex items-center justify-between gap-3 p-3.5 sm:p-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
            <div class="flex items-center gap-2.5 sm:gap-3 flex-grow min-w-0">
              <time datetime={set.date} class="text-[11px] sm:text-xs font-mono text-gray-400 flex-shrink-0">
                {formatDisplayDate(set.date, locale)}
              </time>

              <span class="text-white/20 hidden sm:inline">•</span>

              {showFormatBadge && (
                <span class={`px-2 py-0.5 rounded-full text-[9px] font-bold tracking-wider uppercase border flex-shrink-0 ${badgeInfo.class}`}>
                  {badgeInfo.label}
                </span>
              )}

              <h3 class="text-xs sm:text-sm font-bold text-white tracking-wide truncate">
                {set.title[locale]}
              </h3>
            </div>

            <i class="fas fa-chevron-down text-gray-400 text-xs transition-transform duration-200 group-open:rotate-180 flex-shrink-0"></i>
          </summary>

          <div class="px-4 pb-4 sm:px-5 sm:pb-5 pt-2 border-t border-white/10 text-xs text-gray-300 flex flex-col gap-3">
            <!-- Location & Time Slot row -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-gray-400">
              <span class="flex items-center gap-1.5 text-gray-200">
                <i class="fas fa-location-dot text-[11px]" style={`color: ${accentColor};`}></i>
                <span>{set.venue} — {set.city}</span>
              </span>
              <span class="text-white/20 hidden sm:inline">•</span>
              <span class="flex items-center gap-1.5 text-gray-300">
                <i class="fas fa-clock text-[11px]" style={`color: ${accentColor};`}></i>
                <span>{set.timeSlot[locale]}</span>
              </span>
              {set.duration && (
                <>
                  <span class="text-white/20 hidden sm:inline">•</span>
                  <span class="flex items-center gap-1.5 text-gray-400 font-mono text-[11px]">
                    <i class="fas fa-stopwatch text-[11px]"></i>
                    <span>{set.duration}</span>
                  </span>
                </>
              )}
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-gray-200 leading-relaxed font-normal">
              {set.description[locale]}
            </p>

            <!-- Inline Media Player (when streamable audio/video exists) -->
            {media && media.isEmbeddable && (
              <div class="my-1 w-full">
                <MediaEmbed
                  url={media.url}
                  type={media.platform}
                  title={set.title[locale]}
                  accentColor={accentColor}
                  height={media.platform === 'mixcloud' ? 120 : (media.platform === 'youtube' ? 240 : 120)}
                />
              </div>
            )}

            <!-- Bottom Row: Listen on platform & View Details CTA -->
            <div class="flex items-center justify-between gap-3 pt-1">
              {media ? (
                <a
                  href={media.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-300 hover:text-white transition-colors"
                >
                  <i class={media.icon} style={`color: ${accentColor};`}></i>
                  <span>{media.label}</span>
                  <i class="fas fa-arrow-up-right-from-square text-[9px] opacity-70"></i>
                </a>
              ) : (
                <div />
              )}

              <a
                href={eventHref}
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[11px] font-bold tracking-wider uppercase text-white bg-white/10 hover:bg-white hover:text-black border border-white/20 transition-all duration-200 shadow-sm"
              >
                <span>{t.liveSets.openEventSheet}</span>
                <i class="fas fa-arrow-right text-[9px]"></i>
              </a>
            </div>
          </div>
        </details>
      );
    })
  )}
</div>
