---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from './Footer.astro';
import HeroBanner from './HeroBanner.astro';
import { type Locale, useTranslations } from '../i18n/ui';
import { getFormatMeta } from '../schemas/common';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const rawEvents = await getCollection('events');
const sortedEvents = [...rawEvents].sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function formatDisplayDate(dateStr: string, currentLocale: Locale): string {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString(currentLocale === 'it' ? 'it-IT' : 'en-US', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}
---

<BaseLayout title={t.meta.eventsTitle} description={t.meta.eventsDesc} locale={locale}>
  <!-- Hero Banner -->
  <HeroBanner
    locale={locale}
    title={t.cards.events.title}
    subtitle={t.cards.events.shortDesc}
    badge="EVENTS & RETROSPECTIVES"
    framingKey="events"
    bgImageWebp="/assets/bg-events.webp"
    accent="purple"
  />

  <main class="w-full max-w-5xl flex flex-col gap-10">
    <div class="flex flex-col gap-8">
      {sortedEvents.map((event) => {
        const data = event.data;
        const formatMeta = getFormatMeta(data.format);
        return (
          <article
            id={data.id}
            class="rounded-3xl bg-black/50 border border-white/10 hover:border-white/20 p-6 sm:p-8 backdrop-blur-md shadow-2xl flex flex-col gap-6 scroll-mt-8 transition-all duration-300"
          >
            <!-- Top: Date, Title, Venue & Format Badge -->
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-white/10 pb-5">
              <div>
                <div class="flex items-center gap-2 mb-2">
                  <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-300">
                    <i class="far fa-calendar-alt text-neonPurple text-xs"></i>
                    <time datetime={data.date}>{formatDisplayDate(data.date, locale)}</time>
                  </span>
                  <span class="text-white/20">•</span>
                  <span class="text-xs text-gray-300 font-medium">
                    <i class="fas fa-location-dot text-neonPurple text-xs mr-1"></i>
                    {data.venue ? `${data.venue}, ` : ''}{data.location}
                  </span>
                </div>

                <h2 class="text-xl sm:text-2xl font-black uppercase text-white tracking-wider text-outline">
                  {data.title[locale]}
                </h2>
              </div>

              <span class={`inline-block px-3 py-1 rounded-full text-[10px] font-bold tracking-widest uppercase border w-fit ${formatMeta.eventBadgeClass}`}>
                {formatMeta.fullTitle}
              </span>
            </div>

            <!-- Audio PA Setup & Notes -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="bg-white/5 p-4 rounded-2xl border border-white/5 flex flex-col gap-2">
                <span class="text-[10px] uppercase font-bold tracking-wider text-neonPurple flex items-center gap-1.5">
                  <i class="fas fa-volume-high text-xs"></i>
                  <span>{t.common.audioSetup}</span>
                </span>
                <p class="text-xs text-gray-200 font-normal leading-relaxed">
                  {data.audioSetup}
                </p>
              </div>

              <div class="bg-white/5 p-4 rounded-2xl border border-white/5 flex flex-col gap-2">
                <span class="text-[10px] uppercase font-bold tracking-wider text-neonPurple flex items-center gap-1.5">
                  <i class="fas fa-clipboard-list text-xs"></i>
                  <span>{t.common.technicalNotes}</span>
                </span>
                <p class="text-xs text-gray-200 font-normal leading-relaxed">
                  {data.notes[locale]}
                </p>
              </div>
            </div>

            <!-- Tracklist -->
            {data.tracklist && data.tracklist.length > 0 && (
              <div class="flex flex-col gap-3">
                <span class="text-xs font-bold uppercase tracking-wider text-white flex items-center gap-2">
                  <i class="fas fa-list-ol text-neonPurple text-xs"></i>
                  <span>{t.common.tracklist}</span>
                </span>

                <div class="overflow-x-auto">
                  <table class="w-full text-left text-xs border-collapse">
                    <thead>
                      <tr class="border-b border-white/10 text-[10px] uppercase text-gray-400 font-semibold tracking-wider">
                        <th class="py-2 px-3 w-10">#</th>
                        <th class="py-2 px-3">{t.common.trackTitleHeader}</th>
                        <th class="py-2 px-3">{t.common.trackArtistHeader}</th>
                        <th class="py-2 px-3 text-right">{t.common.trackBpmHeader}</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5 text-gray-200">
                      {data.tracklist.map((track) => (
                        <tr class="hover:bg-white/5 transition-colors">
                          <td class="py-2 px-3 text-gray-400 font-mono">{track.index}</td>
                          <td class="py-2 px-3 font-semibold text-white">{track.title}</td>
                          <td class="py-2 px-3 text-gray-300">{track.artist}</td>
                          <td class="py-2 px-3 text-right text-gray-400 font-mono">{track.bpm ? `${track.bpm}` : '-'}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </article>
        );
      })}
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
