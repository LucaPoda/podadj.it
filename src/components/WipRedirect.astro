---
interface Props {
  target: string;
}

const { target } = Astro.props;
---

<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <title>Redirecting... | Poda DJ</title>
    <script is:inline define:vars={{ target }}>
      window.location.replace(target);
    </script>
  </head>
  <body style="background:#050508;color:#fff;font-family:sans-serif;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0;">
    <p>
      Reindirizzamento in corso...
      <a href={target} style="color:#a855f7;">Continua qui</a>
    </p>
  </body>
</html>
