---
import { type Locale, useTranslations, getLocalizedPath } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getFramingStyle } from '../utils/imageFraming';

interface QuickNavItem {
  label: string;
  href: string;
  icon?: string;
}

interface Props {
  locale: Locale;
  title: string;
  subtitle?: string;
  badge: string;
  framingKey: string;
  bgImageWebp: string;
  bgImageJpg?: string;
  accent?: 'amber' | 'fuchsia' | 'cyan' | 'purple' | 'blue' | 'yellow';
  quickNavItems?: QuickNavItem[];
}

const {
  locale,
  title,
  subtitle,
  badge,
  framingKey,
  bgImageWebp,
  bgImageJpg,
  accent = 'purple',
  quickNavItems = [],
} = Astro.props;

const t = useTranslations(locale);
const homeUrl = getLocalizedPath('/', locale);

const accentStyles = {
  amber: {
    badge: 'bg-amber-500/20 text-amber-300 border-amber-500/40',
    glow: 'from-amber-600/15 via-orange-500/5 to-transparent',
    pill: 'hover:border-amber-400 hover:text-amber-300',
  },
  fuchsia: {
    badge: 'bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-500/40',
    glow: 'from-fuchsia-600/15 via-purple-500/5 to-transparent',
    pill: 'hover:border-fuchsia-400 hover:text-fuchsia-300',
  },
  cyan: {
    badge: 'bg-cyan-500/20 text-cyan-300 border-cyan-500/40',
    glow: 'from-cyan-600/15 via-blue-500/5 to-transparent',
    pill: 'hover:border-cyan-400 hover:text-cyan-300',
  },
  purple: {
    badge: 'bg-neonPurple/20 text-purple-300 border-neonPurple/40',
    glow: 'from-purple-600/15 via-indigo-500/5 to-transparent',
    pill: 'hover:border-neonPurple hover:text-purple-300',
  },
  blue: {
    badge: 'bg-blue-500/20 text-blue-300 border-blue-500/40',
    glow: 'from-blue-600/15 via-cyan-500/5 to-transparent',
    pill: 'hover:border-blue-400 hover:text-blue-300',
  },
  yellow: {
    badge: 'bg-yellow-500/20 text-yellow-300 border-yellow-500/40',
    glow: 'from-yellow-600/15 via-amber-500/5 to-transparent',
    pill: 'hover:border-yellow-400 hover:text-yellow-300',
  },
}[accent];

const mobileBgStyle = getFramingStyle(framingKey, 'mobile', bgImageWebp, bgImageJpg);
const desktopBgStyle = getFramingStyle(framingKey, 'desktop', bgImageWebp, bgImageJpg);
---

<header class="relative w-full max-w-5xl rounded-3xl overflow-hidden border border-white/10 shadow-2xl mb-6 sm:mb-8">
  <!-- Mobile Background (< 768px) with mobile framing config -->
  <div
    class="absolute inset-0 bg-cover md:hidden filter brightness-45"
    style={mobileBgStyle}
  ></div>

  <!-- Desktop Background (>= 768px) with desktop framing config -->
  <div
    class="absolute inset-0 bg-cover hidden md:block filter brightness-45"
    style={desktopBgStyle}
  ></div>

  <!-- Atmospheric Gradient Overlays -->
  <div class="absolute inset-0 bg-gradient-to-t from-[#050508] via-black/55 to-black/35"></div>
  <div class={`absolute inset-0 bg-radial-gradient ${accentStyles.glow} opacity-30 mix-blend-screen pointer-events-none`}></div>

  <!-- Minimal Top Navigation Bar -->
  <div class="relative z-20 flex items-center justify-between p-3.5 sm:p-5 w-full">
    <!-- Back to Home Button -->
    <a
      href={homeUrl}
      class="inline-flex items-center gap-2 text-xs font-semibold tracking-wider uppercase text-gray-300 hover:text-white bg-black/60 hover:bg-black/80 border border-white/20 backdrop-blur-md px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full transition-all duration-300 shadow-md hover:border-white/40"
    >
      <i class="fas fa-arrow-left text-[10px]"></i>
      <span>{t.nav.backHome}</span>
    </a>

    <!-- Language Switcher -->
    <div class="flex items-center">
      <LanguageSwitcher currentLocale={locale} />
    </div>
  </div>

  <!-- Hero Content Center -->
  <div class="relative z-10 flex flex-col items-center justify-center text-center px-4 pt-1 pb-6 sm:pb-8 max-w-3xl mx-auto">
    <!-- Category Badge -->
    <span class={`inline-block px-3 py-0.5 rounded-full text-[10px] sm:text-xs font-bold tracking-widest uppercase border backdrop-blur-md mb-2 sm:mb-2.5 ${accentStyles.badge}`}>
      {badge}
    </span>

    <!-- Format Title -->
    <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-white uppercase tracking-wider text-outline mb-2">
      {title}
    </h1>

    <!-- Subtitle / Tagline -->
    {subtitle && (
      <p class="text-xs sm:text-sm text-gray-200 font-normal leading-relaxed max-w-xl text-shadow-soft mb-5 px-2">
        {subtitle}
      </p>
    )}

    <!-- Quick Navigation Anchors -->
    {quickNavItems.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-2.5">
        {quickNavItems.map((item) => (
          <a
            href={item.href}
            class={`inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wider bg-black/55 border border-white/20 text-gray-200 backdrop-blur-md transition-all duration-200 shadow-md ${accentStyles.pill}`}
          >
            {item.icon && <i class={`${item.icon} text-[11px]`}></i>}
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</header>
