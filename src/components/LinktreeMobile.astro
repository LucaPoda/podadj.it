---
import { type Locale, useTranslations, getLocalizedPath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const partySideUrl = getLocalizedPath('/party-side', locale);
const grooveSideUrl = getLocalizedPath('/groove-side', locale);
const mainstageSideUrl = getLocalizedPath('/mainstage-side', locale);
const techSideUrl = getLocalizedPath('/tech-side', locale);
const demoLiveUrl = getLocalizedPath('/demo-live-sets', locale);
const eventsUrl = getLocalizedPath('/events', locale);

const links = [
  {
    title: t.cards.partySide.title,
    subtitle: t.cards.partySide.subtitle,
    badge: t.cards.partySide.badge,
    badgeColor: 'border-neonPurple/50 text-neonPurple bg-neonPurple/20',
    url: partySideUrl,
    image: '/assets/bg-party.webp',
    imageJpg: '/assets/bg-party.jpg',
    isExternal: false,
  },
  {
    title: t.cards.grooveSide.title,
    subtitle: t.cards.grooveSide.subtitle,
    badge: t.cards.grooveSide.badge,
    badgeColor: 'border-blue-400/50 text-neonBlue bg-blue-500/20',
    url: grooveSideUrl,
    image: '/assets/bg-deeper.webp',
    imageJpg: '/assets/bg-deeper.jpg',
    isExternal: false,
  },
  {
    title: t.cards.mainstageSide.title,
    subtitle: t.cards.mainstageSide.subtitle,
    badge: t.cards.mainstageSide.badge,
    badgeColor: 'border-red-400/50 text-red-400 bg-red-500/20',
    url: mainstageSideUrl,
    image: '/assets/bg-harder.webp',
    imageJpg: '/assets/bg-harder.jpg',
    isExternal: false,
  },
  {
    title: t.cards.techSide.title,
    subtitle: t.cards.techSide.subtitle,
    badge: t.cards.techSide.badge,
    badgeColor: 'border-emerald-400/50 text-emerald-400 bg-emerald-500/20',
    url: techSideUrl,
    image: '/assets/bg-tech.webp',
    imageJpg: '/assets/bg-tech.jpg',
    isExternal: false,
  },
  {
    title: t.cards.demoLive.title,
    subtitle: t.cards.demoLive.subtitle,
    badge: 'Audio Sets',
    badgeColor: 'border-purple-400/50 text-purple-300 bg-purple-500/20',
    url: demoLiveUrl,
    image: '/assets/bg-livesets.webp',
    imageJpg: '/assets/bg-livesets.jpg',
    isExternal: false,
  },
  {
    title: t.cards.events.title,
    subtitle: t.cards.events.subtitle,
    badge: 'Tracklists',
    badgeColor: 'border-amber-400/50 text-amber-300 bg-amber-500/20',
    url: eventsUrl,
    image: '/assets/bg-events.webp',
    imageJpg: '/assets/bg-events.jpg',
    isExternal: false,
  },
  {
    title: t.cards.partyhive.title,
    subtitle: t.cards.partyhive.subtitle,
    badge: 'Partner',
    badgeColor: 'border-pink-400/50 text-pink-300 bg-pink-500/20',
    url: 'https://instagram.com/partyhive_official',
    image: '/assets/bg-partyhive.webp',
    imageJpg: '/assets/bg-partyhive.jpg',
    isExternal: true,
  },
];
---

<nav aria-label="Menu Linktree Rapido" class="flex md:hidden flex-col gap-3 w-full mt-6">
  
  <!-- 7 Linktree Cards Stacked -->
  {links.map((link) => (
    <a
      href={link.url}
      target={link.isExternal ? '_blank' : undefined}
      rel={link.isExternal ? 'noopener noreferrer' : undefined}
      class="group relative w-full h-[82px] sm:h-[88px] rounded-2xl overflow-hidden flex items-center justify-between px-4 sm:px-5 border border-white/20 shadow-xl transition-all duration-200 active:scale-[0.98] active:border-neonPurple/80"
    >
      <!-- Background image -->
      <div
        class="absolute inset-0 bg-cover bg-center filter brightness-[0.4] group-active:brightness-[0.3] transition-all duration-300"
        style={`background-image: url('${link.image}'), url('${link.imageJpg}');`}
      ></div>

      <!-- Gradient overlay for strong readability -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/60 to-black/75 z-[1]"></div>
      
      <!-- Text content -->
      <div class="relative z-10 flex flex-col items-start gap-1 pr-3">
        <span class={`text-[9px] sm:text-[10px] font-extrabold uppercase tracking-widest px-2 py-0.5 rounded-full border ${link.badgeColor}`}>
          {link.badge}
        </span>
        <h2 class="text-base sm:text-lg font-bold text-white uppercase tracking-wider text-outline leading-tight">
          {link.title}
        </h2>
        <span class="text-[11px] sm:text-xs text-gray-300 font-medium tracking-wide truncate max-w-[220px] sm:max-w-xs text-shadow-soft">
          {link.subtitle}
        </span>
      </div>

      <!-- Action Arrow Button -->
      <div class="relative z-10 flex-none w-9 h-9 rounded-full bg-white/10 border border-white/25 backdrop-blur-md flex items-center justify-center text-white/90 group-active:bg-neonPurple group-active:text-white group-active:border-neonPurple transition-all shadow-md">
        {link.isExternal ? (
          <i class="fas fa-arrow-up-right-from-square text-xs"></i>
        ) : (
          <i class="fas fa-chevron-right text-xs"></i>
        )}
      </div>

      <!-- Neon active glow border -->
      <div class="absolute inset-0 rounded-2xl border border-transparent group-active:border-neonPurple pointer-events-none transition-colors"></div>
    </a>
  ))}

  <!-- Mobile Quick Action Tap Bar (Contact directly with 1 tap) -->
  <div class="w-full mt-4 p-4 rounded-2xl bg-black/40 border border-white/10 backdrop-blur-md shadow-xl flex flex-col gap-3 text-center">
    <span class="text-xs uppercase tracking-widest font-semibold text-gray-300">
      {locale === 'it' ? 'Contatto Rapido & Booking' : 'Quick Contact & Booking'}
    </span>
    
    <div class="grid grid-cols-3 gap-2.5">
      <a
        href={`mailto:${t.footer.email}`}
        class="flex flex-col items-center justify-center gap-1.5 py-3 px-2 rounded-xl bg-white/5 border border-white/10 hover:border-neonPurple hover:bg-neonPurple/20 transition-all text-gray-200 active:scale-95"
      >
        <i class="fas fa-envelope text-neonPurple text-lg"></i>
        <span class="text-[11px] font-medium tracking-wider">Email</span>
      </a>

      <a
        href="https://instagram.com/podadj_official"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center justify-center gap-1.5 py-3 px-2 rounded-xl bg-white/5 border border-white/10 hover:border-neonPurple hover:bg-neonPurple/20 transition-all text-gray-200 active:scale-95"
      >
        <i class="fab fa-instagram text-neonPurple text-lg"></i>
        <span class="text-[11px] font-medium tracking-wider">Instagram</span>
      </a>

      <a
        href="https://soundcloud.com/podadj"
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center justify-center gap-1.5 py-3 px-2 rounded-xl bg-white/5 border border-white/10 hover:border-neonPurple hover:bg-neonPurple/20 transition-all text-gray-200 active:scale-95"
      >
        <i class="fab fa-soundcloud text-neonPurple text-lg"></i>
        <span class="text-[11px] font-medium tracking-wider">SoundCloud</span>
      </a>
    </div>
  </div>

</nav>
