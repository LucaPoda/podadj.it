---
import { type Locale, useTranslations, getLocalizedPath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const partySideUrl = getLocalizedPath('/party-side', locale);
const grooveSideUrl = getLocalizedPath('/groove-side', locale);
const mainstageSideUrl = getLocalizedPath('/mainstage-side', locale);
const techSideUrl = getLocalizedPath('/tech-side', locale);
const demoLiveUrl = getLocalizedPath('/demo-live-sets', locale);
const eventsUrl = getLocalizedPath('/events', locale);
---

<div class="hidden md:flex flex-col w-full">
  
  <!-- 1. Central Bento Grid (First Screen Viewport Fit: Clean Titles, No Labels, Pixel-Perfect Alignment) -->
  <section aria-label="Format Musicali e Service" class="w-full mt-5 lg:mt-6 grid grid-cols-[1.55fr_1fr] grid-rows-3 gap-5 lg:gap-6">
    
    <!-- Row 1 Left: THE PARTY SIDE -->
    <a
      href={partySideUrl}
      class="format-card h-[145px] lg:h-[165px] xl:h-[180px] w-full group relative"
      aria-label={t.cards.partySide.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-party.webp'), url('/assets/bg-party.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY (No labels/subtitles) -->
      <div class="absolute inset-0 flex items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h2 class="text-2xl lg:text-3xl xl:text-4xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.partySide.title}
        </h2>
      </div>

      <!-- Hover state: Rich Description & Details Button -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-4 lg:py-5 px-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h2 class="text-lg lg:text-xl font-bold tracking-wider text-white uppercase text-outline transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          {t.cards.partySide.title}
        </h2>
        
        <div class="flex flex-col items-center gap-2.5 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 max-w-lg">
          <p class="text-xs lg:text-sm text-gray-100 font-medium leading-relaxed text-outline line-clamp-2 lg:line-clamp-3">
            {t.cards.partySide.shortDesc}
          </p>
          <span class="px-5 py-1 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.partySide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Row 2 Left: THE GROOVE SIDE -->
    <a
      href={grooveSideUrl}
      class="format-card h-[145px] lg:h-[165px] xl:h-[180px] w-full group relative"
      aria-label={t.cards.grooveSide.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-deeper.webp'), url('/assets/bg-deeper.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h2 class="text-2xl lg:text-3xl xl:text-4xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.grooveSide.title}
        </h2>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-4 lg:py-5 px-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h2 class="text-lg lg:text-xl font-bold tracking-wider text-white uppercase text-outline transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          {t.cards.grooveSide.title}
        </h2>
        
        <div class="flex flex-col items-center gap-2.5 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 max-w-lg">
          <p class="text-xs lg:text-sm text-gray-100 font-medium leading-relaxed text-outline line-clamp-2 lg:line-clamp-3">
            {t.cards.grooveSide.shortDesc}
          </p>
          <span class="px-5 py-1 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.grooveSide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Row 3 Left: THE MAINSTAGE SIDE -->
    <a
      href={mainstageSideUrl}
      class="format-card h-[145px] lg:h-[165px] xl:h-[180px] w-full group relative"
      aria-label={t.cards.mainstageSide.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-harder.webp'), url('/assets/bg-harder.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h2 class="text-2xl lg:text-3xl xl:text-4xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.mainstageSide.title}
        </h2>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-4 lg:py-5 px-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h2 class="text-lg lg:text-xl font-bold tracking-wider text-white uppercase text-outline transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          {t.cards.mainstageSide.title}
        </h2>
        
        <div class="flex flex-col items-center gap-2.5 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 max-w-lg">
          <p class="text-xs lg:text-sm text-gray-100 font-medium leading-relaxed text-outline line-clamp-2 lg:line-clamp-3">
            {t.cards.mainstageSide.shortDesc}
          </p>
          <span class="px-5 py-1 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.mainstageSide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Column 2 Right: THE TECH SIDE (Spans all 3 rows, aligned to the exact pixel) -->
    <a
      href={techSideUrl}
      class="format-card col-start-2 row-start-1 row-span-3 h-full w-full group relative"
      aria-label={t.cards.techSide.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-tech.webp'), url('/assets/bg-tech.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h2 class="text-2xl lg:text-3xl xl:text-4xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.techSide.title}
        </h2>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-8 px-7 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h2 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline transform -translate-y-3 group-hover:translate-y-0 transition-transform duration-500">
          {t.cards.techSide.title}
        </h2>
        
        <div class="flex flex-col items-center gap-4 transform translate-y-3 group-hover:translate-y-0 transition-transform duration-500">
          <p class="text-sm text-gray-100 font-medium leading-relaxed text-outline">
            {t.cards.techSide.shortDesc}
          </p>
          <span class="px-6 py-2 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.techSide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>
  </section>

  <!-- Elegant Scroll Prompt (Informs the user that more content is below) -->
  <div class="w-full flex justify-center mt-6 lg:mt-8">
    <a
      href="#more-sections"
      class="group flex flex-col items-center gap-1.5 text-gray-400 hover:text-white transition-colors duration-300"
      aria-label="Scorri alle sezioni successive"
    >
      <span class="text-[11px] font-semibold tracking-widest uppercase opacity-75 group-hover:opacity-100">
        {locale === 'it' ? 'Demo, Eventi & Progetti' : 'Demos, Events & Projects'}
      </span>
      <i class="fas fa-chevron-down text-xs text-neonPurple animate-bounce"></i>
    </a>
  </div>

  <!-- 2. Lower Grid (3 equal columns: Demo & Live Sets, Events, Partyhive) -->
  <section id="more-sections" aria-label="Sezioni Aggiuntive" class="w-full mt-10 lg:mt-12 grid grid-cols-3 gap-6">
    
    <!-- Lower Card 1: DEMO & LIVE SETS -->
    <a
      href={demoLiveUrl}
      class="format-card aspect-square w-full group relative"
      aria-label={t.cards.demoLive.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-livesets.webp'), url('/assets/bg-livesets.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h3 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.demoLive.title}
        </h3>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h3 class="text-lg font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.demoLive.title}
        </h3>
        <p class="text-xs text-gray-200 leading-relaxed text-outline max-w-[240px]">
          {t.cards.demoLive.shortDesc}
        </p>
        <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto transform translate-y-2 group-hover:translate-y-0">
          {t.cards.demoLive.cta}
        </span>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Lower Card 2: EVENTS -->
    <a
      href={eventsUrl}
      class="format-card aspect-square w-full group relative"
      aria-label={t.cards.events.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-events.webp'), url('/assets/bg-events.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h3 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.events.title}
        </h3>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h3 class="text-lg font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.events.title}
        </h3>
        <p class="text-xs text-gray-200 leading-relaxed text-outline max-w-[240px]">
          {t.cards.events.shortDesc}
        </p>
        <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto transform translate-y-2 group-hover:translate-y-0">
          {t.cards.events.cta}
        </span>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Lower Card 3: PARTYHIVE -->
    <a
      href="https://instagram.com/partyhive_official"
      target="_blank"
      rel="noopener noreferrer"
      class="format-card aspect-square w-full group relative"
      aria-label={t.cards.partyhive.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-partyhive.webp'), url('/assets/bg-partyhive.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h3 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.partyhive.title}
        </h3>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h3 class="text-lg font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.partyhive.title}
        </h3>
        <p class="text-xs text-gray-200 leading-relaxed text-outline max-w-[240px]">
          {t.cards.partyhive.shortDesc}
        </p>
        <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto transform translate-y-2 group-hover:translate-y-0">
          {t.cards.partyhive.cta}
        </span>
      </div>
      
      <div class="border-neon"></div>
    </a>
  </section>

</div>
