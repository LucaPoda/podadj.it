---
import { type Locale, useTranslations, getLocalizedPath } from '../i18n/ui';
import { getFramingStyle } from '../utils/imageFraming';
import { siteLinks } from '../data/siteLinks';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const partySideUrl = getLocalizedPath('/party-side', locale);
const grooveSideUrl = getLocalizedPath('/groove-side', locale);
const mainstageSideUrl = getLocalizedPath('/mainstage-side', locale);
const techSideUrl = getLocalizedPath('/tech-side', locale);
const demoLiveUrl = getLocalizedPath('/demo-live-sets', locale);
const eventsUrl = getLocalizedPath('/events', locale);
---

<div class="hidden md:flex flex-col w-full">
  
  <!-- 1. Central Bento Grid (Calibrata a 2/3 e 1/3, rientra perfettamente a zoom 100% fino allo scroll prompt) -->
  <section aria-label="Format Musicali e Service" class="w-full mt-4 lg:mt-5 grid grid-cols-[2fr_1fr] grid-rows-3 gap-4 lg:gap-5">
    
    <!-- Row 1 Left: THE MAINSTAGE SIDE -->
    <a
      href={mainstageSideUrl}
      class="format-card h-[135px] lg:h-[148px] xl:h-[160px] w-full group relative"
      aria-label={t.cards.mainstageSide.title}
    >
      <div class="bg-image" style={getFramingStyle('mainstage-side', 'desktop', '/assets/bg-mainstage.webp', '/assets/bg-mainstage.jpg')}></div>
      <div class="overlay"></div>
      
      <!-- Default state -->
      <div class="absolute inset-0 flex items-center justify-center p-4 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h2 class="text-2xl lg:text-3xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.mainstageSide.title}
        </h2>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-3.5 lg:py-4 px-5 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h2 class="text-base lg:text-lg font-bold tracking-wider text-white uppercase text-outline transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          {t.cards.mainstageSide.title}
        </h2>
        
        <div class="flex flex-col items-center gap-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 max-w-lg">
          <p class="text-[11px] lg:text-xs text-gray-100 font-medium leading-snug text-outline line-clamp-2 lg:line-clamp-3">
            {t.cards.mainstageSide.shortDesc}
          </p>
          <span class="px-4 py-1 border border-white/60 rounded-full text-[11px] font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.mainstageSide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Row 2 Left: THE PARTY SIDE -->
    <a
      href={partySideUrl}
      class="format-card h-[135px] lg:h-[148px] xl:h-[160px] w-full group relative"
      aria-label={t.cards.partySide.title}
    >
      <div class="bg-image" style={getFramingStyle('party-side', 'desktop', '/assets/bg-party.webp', '/assets/bg-party.jpg')}></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-4 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h2 class="text-2xl lg:text-3xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.partySide.title}
        </h2>
      </div>

      <!-- Hover state: Descrizione Instagram & Dettagli Button -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-3.5 lg:py-4 px-5 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h2 class="text-base lg:text-lg font-bold tracking-wider text-white uppercase text-outline transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          {t.cards.partySide.title}
        </h2>
        
        <div class="flex flex-col items-center gap-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 max-w-lg">
          <p class="text-[11px] lg:text-xs text-gray-100 font-medium leading-snug text-outline line-clamp-2 lg:line-clamp-3">
            {t.cards.partySide.shortDesc}
          </p>
          <span class="px-4 py-1 border border-white/60 rounded-full text-[11px] font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.partySide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Row 3 Left: THE GROOVE SIDE -->
    <a
      href={grooveSideUrl}
      class="format-card h-[135px] lg:h-[148px] xl:h-[160px] w-full group relative"
      aria-label={t.cards.grooveSide.title}
    >
      <div class="bg-image" style={getFramingStyle('groove-side', 'desktop', '/assets/bg-groove.webp', '/assets/bg-groove.jpg')}></div>
      <div class="overlay"></div>
      
      <!-- Default state -->
      <div class="absolute inset-0 flex items-center justify-center p-4 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h2 class="text-2xl lg:text-3xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.grooveSide.title}
        </h2>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-3.5 lg:py-4 px-5 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h2 class="text-base lg:text-lg font-bold tracking-wider text-white uppercase text-outline transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          {t.cards.grooveSide.title}
        </h2>
        
        <div class="flex flex-col items-center gap-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 max-w-lg">
          <p class="text-[11px] lg:text-xs text-gray-100 font-medium leading-snug text-outline line-clamp-2 lg:line-clamp-3">
            {t.cards.grooveSide.shortDesc}
          </p>
          <span class="px-4 py-1 border border-white/60 rounded-full text-[11px] font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.grooveSide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Column 2 Right: THE TECH SIDE (Spans all 3 rows, aligned to the exact pixel) -->
    <a
      href={techSideUrl}
      class="format-card col-start-2 row-start-1 row-span-3 h-full w-full group relative"
      aria-label={t.cards.techSide.title}
    >
      <div class="bg-image" style={getFramingStyle('tech-side', 'desktop', '/assets/bg-tech.webp', '/assets/bg-tech.jpg')}></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h2 class="text-2xl lg:text-3xl xl:text-4xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.techSide.title}
        </h2>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-6 px-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h2 class="text-lg lg:text-xl font-bold tracking-wider text-white uppercase text-outline transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          {t.cards.techSide.title}
        </h2>
        
        <div class="flex flex-col items-center gap-3 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          <p class="text-xs lg:text-sm text-gray-100 font-medium leading-relaxed text-outline">
            {t.cards.techSide.shortDesc}
          </p>
          <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.techSide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>
  </section>

  <!-- Elegant Scroll Prompt (Arriva esattamente qui a zoom 100%) -->
  <div class="w-full flex justify-center mt-5 lg:mt-6">
    <a
      href="#more-sections"
      class="group flex flex-col items-center gap-1 text-gray-300 hover:text-white transition-colors duration-300"
      aria-label="Scorri alle sezioni successive"
    >
      <span class="text-[11px] font-semibold tracking-widest uppercase opacity-85 group-hover:opacity-100 text-shadow-soft">
        {t.common.scrollPrompt}
      </span>
      <i class="fas fa-chevron-down text-xs text-neonPurple animate-bounce"></i>
    </a>
  </div>

  <!-- 2. Lower Grid (3 equal columns: Demo & Live Sets, Events, Partyhive - Stessa altezza e gap della griglia sopra) -->
  <section id="more-sections" aria-label="Sezioni Aggiuntive" class="w-full mt-10 lg:mt-12 grid grid-cols-3 gap-4 lg:gap-5">
    
    <!-- Lower Card 1: DEMO & LIVE SETS (Rettangolare, altezza identica alle card sopra) -->
    <a
      href={demoLiveUrl}
      class="format-card h-[135px] lg:h-[148px] xl:h-[160px] w-full group relative"
      aria-label={t.cards.demoLive.title}
    >
      <div class="bg-image" style={getFramingStyle('demo-live', 'desktop', '/assets/bg-livesets.webp', '/assets/bg-livesets.jpg')}></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-4 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h3 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.demoLive.title}
        </h3>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-1.5 lg:gap-2 p-4 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h3 class="text-base lg:text-lg font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.demoLive.title}
        </h3>
        <p class="text-[11px] lg:text-xs text-gray-200 leading-snug text-outline max-w-[260px] line-clamp-2">
          {t.cards.demoLive.shortDesc}
        </p>
        <span class="px-4 py-1 border border-white/60 rounded-full text-[11px] font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto transform translate-y-1 group-hover:translate-y-0">
          {t.cards.demoLive.cta}
        </span>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Lower Card 2: EVENTS (Rettangolare, altezza identica alle card sopra) -->
    <a
      href={eventsUrl}
      class="format-card h-[135px] lg:h-[148px] xl:h-[160px] w-full group relative"
      aria-label={t.cards.events.title}
    >
      <div class="bg-image" style={getFramingStyle('events', 'desktop', '/assets/bg-events.webp', '/assets/bg-events.jpg')}></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-4 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h3 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.events.title}
        </h3>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-1.5 lg:gap-2 p-4 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h3 class="text-base lg:text-lg font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.events.title}
        </h3>
        <p class="text-[11px] lg:text-xs text-gray-200 leading-snug text-outline max-w-[260px] line-clamp-2">
          {t.cards.events.shortDesc}
        </p>
        <span class="px-4 py-1 border border-white/60 rounded-full text-[11px] font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto transform translate-y-1 group-hover:translate-y-0">
          {t.cards.events.cta}
        </span>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Lower Card 3: PARTYHIVE (Rettangolare, larghezza = The Tech Side, altezza identica alle card sopra) -->
    <a
      href={siteLinks.socials.instagramPartyhive.url}
      target="_blank"
      rel="noopener noreferrer"
      class="format-card h-[135px] lg:h-[148px] xl:h-[160px] w-full group relative"
      aria-label={t.cards.partyhive.title}
    >
      <div class="bg-image" style={getFramingStyle('partyhive', 'desktop', '/assets/bg-partyhive.webp', '/assets/bg-partyhive.jpg')}></div>
      <div class="overlay"></div>
      
      <!-- Default state: Clean Title ONLY -->
      <div class="absolute inset-0 flex items-center justify-center p-4 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h3 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.partyhive.title}
        </h3>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-1.5 lg:gap-2 p-4 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h3 class="text-base lg:text-lg font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.partyhive.title}
        </h3>
        <p class="text-[11px] lg:text-xs text-gray-200 leading-snug text-outline max-w-[260px] line-clamp-2">
          {t.cards.partyhive.shortDesc}
        </p>
        <span class="px-4 py-1 border border-white/60 rounded-full text-[11px] font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto transform translate-y-1 group-hover:translate-y-0">
          {t.cards.partyhive.cta}
        </span>
      </div>
      
      <div class="border-neon"></div>
    </a>
  </section>

</div>
