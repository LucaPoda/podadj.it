---
import { type Locale, useTranslations, getLocalizedPath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const partySideUrl = getLocalizedPath('/party-side', locale);
const grooveSideUrl = getLocalizedPath('/groove-side', locale);
const mainstageSideUrl = getLocalizedPath('/mainstage-side', locale);
const techSideUrl = getLocalizedPath('/tech-side', locale);
const demoLiveUrl = getLocalizedPath('/demo-live-sets', locale);
const eventsUrl = getLocalizedPath('/events', locale);
---

<div class="hidden md:flex flex-col w-full mt-8 md:mt-10">
  
  <!-- 1. Central Bento Grid (Asymmetrical 2 columns, pixel-perfect bottom alignment) -->
  <section aria-label="Format Musicali e Service" class="w-full grid grid-cols-[1.55fr_1fr] grid-rows-3 gap-6">
    
    <!-- Row 1 Left: THE PARTY SIDE -->
    <a
      href={partySideUrl}
      class="format-card h-[210px] lg:h-[230px] w-full group relative"
      aria-label={t.cards.partySide.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-party.webp'), url('/assets/bg-party.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state: Title & Badge -->
      <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <span class="inline-block text-[11px] font-bold tracking-widest uppercase px-3 py-1 rounded-full bg-neonPurple/30 border border-neonPurple/50 text-white mb-2 shadow-[0_0_12px_rgba(168,85,247,0.4)]">
          {t.cards.partySide.badge}
        </span>
        <h2 class="text-2xl lg:text-3xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.partySide.title}
        </h2>
        <p class="text-xs text-gray-200 font-medium tracking-wider mt-1 text-shadow-soft">
          {t.cards.partySide.subtitle}
        </p>
      </div>

      <!-- Hover state: Info & CTA -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-6 px-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <div class="flex flex-col items-center transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          <span class="text-[10px] font-bold tracking-widest uppercase text-neonPurple mb-1">
            {t.cards.partySide.badge}
          </span>
          <h2 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline">
            {t.cards.partySide.title}
          </h2>
        </div>
        
        <div class="flex flex-col items-center gap-3 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 max-w-lg">
          <p class="text-xs lg:text-sm text-gray-100 font-medium leading-relaxed text-outline">
            {t.cards.partySide.shortDesc}
          </p>
          <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.partySide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Row 2 Left: THE GROOVE SIDE -->
    <a
      href={grooveSideUrl}
      class="format-card h-[210px] lg:h-[230px] w-full group relative"
      aria-label={t.cards.grooveSide.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-deeper.webp'), url('/assets/bg-deeper.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <span class="inline-block text-[11px] font-bold tracking-widest uppercase px-3 py-1 rounded-full bg-blue-500/30 border border-blue-400/50 text-white mb-2 shadow-[0_0_12px_rgba(59,130,246,0.4)]">
          {t.cards.grooveSide.badge}
        </span>
        <h2 class="text-2xl lg:text-3xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.grooveSide.title}
        </h2>
        <p class="text-xs text-gray-200 font-medium tracking-wider mt-1 text-shadow-soft">
          {t.cards.grooveSide.subtitle}
        </p>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-6 px-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <div class="flex flex-col items-center transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          <span class="text-[10px] font-bold tracking-widest uppercase text-neonBlue mb-1">
            {t.cards.grooveSide.badge}
          </span>
          <h2 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline">
            {t.cards.grooveSide.title}
          </h2>
        </div>
        
        <div class="flex flex-col items-center gap-3 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 max-w-lg">
          <p class="text-xs lg:text-sm text-gray-100 font-medium leading-relaxed text-outline">
            {t.cards.grooveSide.shortDesc}
          </p>
          <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.grooveSide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Row 3 Left: THE MAINSTAGE SIDE -->
    <a
      href={mainstageSideUrl}
      class="format-card h-[210px] lg:h-[230px] w-full group relative"
      aria-label={t.cards.mainstageSide.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-harder.webp'), url('/assets/bg-harder.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <span class="inline-block text-[11px] font-bold tracking-widest uppercase px-3 py-1 rounded-full bg-red-500/30 border border-red-400/50 text-white mb-2 shadow-[0_0_12px_rgba(239,68,68,0.4)]">
          {t.cards.mainstageSide.badge}
        </span>
        <h2 class="text-2xl lg:text-3xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.mainstageSide.title}
        </h2>
        <p class="text-xs text-gray-200 font-medium tracking-wider mt-1 text-shadow-soft">
          {t.cards.mainstageSide.subtitle}
        </p>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-6 px-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <div class="flex flex-col items-center transform -translate-y-2 group-hover:translate-y-0 transition-transform duration-500">
          <span class="text-[10px] font-bold tracking-widest uppercase text-red-400 mb-1">
            {t.cards.mainstageSide.badge}
          </span>
          <h2 class="text-xl lg:text-2xl font-bold tracking-wider text-white uppercase text-outline">
            {t.cards.mainstageSide.title}
          </h2>
        </div>
        
        <div class="flex flex-col items-center gap-3 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-500 max-w-lg">
          <p class="text-xs lg:text-sm text-gray-100 font-medium leading-relaxed text-outline">
            {t.cards.mainstageSide.shortDesc}
          </p>
          <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.mainstageSide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Column 2 Right: THE TECH SIDE (Spans all 3 rows, aligned to the pixel) -->
    <a
      href={techSideUrl}
      class="format-card col-start-2 row-start-1 row-span-3 h-full w-full group relative"
      aria-label={t.cards.techSide.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-tech.webp'), url('/assets/bg-tech.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center p-6 lg:p-8 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <span class="inline-block text-[11px] font-bold tracking-widest uppercase px-3 py-1 rounded-full bg-emerald-500/30 border border-emerald-400/50 text-white mb-3 shadow-[0_0_12px_rgba(16,185,129,0.4)]">
          {t.cards.techSide.badge}
        </span>
        <h2 class="text-2xl lg:text-3xl font-extrabold tracking-wider text-white uppercase text-outline">
          {t.cards.techSide.title}
        </h2>
        <p class="text-xs lg:text-sm text-gray-200 font-medium tracking-wider mt-1 text-shadow-soft">
          {t.cards.techSide.subtitle}
        </p>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-between py-10 px-8 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <div class="flex flex-col items-center transform -translate-y-3 group-hover:translate-y-0 transition-transform duration-500">
          <span class="text-[10px] font-bold tracking-widest uppercase text-emerald-400 mb-1">
            {t.cards.techSide.badge}
          </span>
          <h2 class="text-2xl lg:text-3xl font-bold tracking-wider text-white uppercase text-outline">
            {t.cards.techSide.title}
          </h2>
        </div>
        
        <div class="flex flex-col items-center gap-5 transform translate-y-3 group-hover:translate-y-0 transition-transform duration-500">
          <p class="text-sm lg:text-base text-gray-100 font-medium leading-relaxed text-outline">
            {t.cards.techSide.shortDesc}
          </p>
          <span class="px-6 py-2 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto">
            {t.cards.techSide.cta}
          </span>
        </div>
      </div>
      
      <div class="border-neon"></div>
    </a>
  </section>

  <!-- 2. Lower Grid (3 equal columns: Demo & Live Sets, Events, Partyhive) -->
  <section aria-label="Sezioni Aggiuntive" class="w-full mt-12 lg:mt-16 grid grid-cols-3 gap-6">
    
    <!-- Lower Card 1: DEMO & LIVE SETS -->
    <a
      href={demoLiveUrl}
      class="format-card aspect-square w-full group relative"
      aria-label={t.cards.demoLive.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-livesets.webp'), url('/assets/bg-livesets.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h3 class="text-lg lg:text-xl font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.demoLive.title}
        </h3>
        <p class="text-[11px] text-gray-200 tracking-wider mt-1 text-shadow-soft">
          {t.cards.demoLive.subtitle}
        </p>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h3 class="text-lg font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.demoLive.title}
        </h3>
        <p class="text-xs text-gray-200 leading-relaxed text-outline max-w-[240px]">
          {t.cards.demoLive.shortDesc}
        </p>
        <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto transform translate-y-2 group-hover:translate-y-0">
          {t.cards.demoLive.cta}
        </span>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Lower Card 2: EVENTS -->
    <a
      href={eventsUrl}
      class="format-card aspect-square w-full group relative"
      aria-label={t.cards.events.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-events.webp'), url('/assets/bg-events.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h3 class="text-lg lg:text-xl font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.events.title}
        </h3>
        <p class="text-[11px] text-gray-200 tracking-wider mt-1 text-shadow-soft">
          {t.cards.events.subtitle}
        </p>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h3 class="text-lg font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.events.title}
        </h3>
        <p class="text-xs text-gray-200 leading-relaxed text-outline max-w-[240px]">
          {t.cards.events.shortDesc}
        </p>
        <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto transform translate-y-2 group-hover:translate-y-0">
          {t.cards.events.cta}
        </span>
      </div>
      
      <div class="border-neon"></div>
    </a>

    <!-- Lower Card 3: PARTYHIVE -->
    <a
      href="https://instagram.com/partyhive_official"
      target="_blank"
      rel="noopener noreferrer"
      class="format-card aspect-square w-full group relative"
      aria-label={t.cards.partyhive.title}
    >
      <div class="bg-image" style="background-image: url('/assets/bg-partyhive.webp'), url('/assets/bg-partyhive.jpg');"></div>
      <div class="overlay"></div>
      
      <!-- Default state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center z-10 transition-all duration-500 opacity-100 group-hover:opacity-0 group-hover:scale-95">
        <h3 class="text-lg lg:text-xl font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.partyhive.title}
        </h3>
        <p class="text-[11px] text-gray-200 tracking-wider mt-1 text-shadow-soft">
          {t.cards.partyhive.subtitle}
        </p>
      </div>

      <!-- Hover state -->
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 p-6 text-center z-20 opacity-0 group-hover:opacity-100 transition-all duration-500 pointer-events-none">
        <h3 class="text-lg font-bold tracking-wider text-white uppercase text-outline">
          {t.cards.partyhive.title}
        </h3>
        <p class="text-xs text-gray-200 leading-relaxed text-outline max-w-[240px]">
          {t.cards.partyhive.shortDesc}
        </p>
        <span class="px-5 py-1.5 border border-white/60 rounded-full text-xs font-bold uppercase tracking-widest text-white backdrop-blur-md group-hover:bg-white group-hover:text-black transition-all duration-300 shadow-lg pointer-events-auto transform translate-y-2 group-hover:translate-y-0">
          {t.cards.partyhive.cta}
        </span>
      </div>
      
      <div class="border-neon"></div>
    </a>
  </section>

</div>
