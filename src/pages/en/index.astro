---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations } from '../../i18n/ui';

const locale = 'en';
const t = useTranslations(locale);
---

<BaseLayout title={t.meta.title} description={t.meta.description} locale={locale}>
  <Header locale={locale} />
  
  <main class="w-full mt-8 md:mt-10">
    <div class="text-center py-12 text-white">
      <h2 class="text-2xl font-bold uppercase tracking-wider text-outline">
        PODA DJ — Official Web Platform
      </h2>
      <p class="text-gray-300 mt-2 text-sm text-shadow-soft">
        Phase 1 completed: Astro 5, i18n & Assets Pipeline active.
      </p>
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
