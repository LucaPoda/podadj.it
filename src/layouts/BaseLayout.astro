---
import '../styles/global.css';
import { type Locale, switchLocalePath } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  noindex?: boolean;
}

const {
  title = 'Poda DJ | Electronic Music & Audio Systems',
  description = 'DJ Producer & Pro Audio Solutions per festival, club ed eventi privati.',
  locale = 'it',
  noindex = false,
} = Astro.props;

const siteBase = Astro.site || 'https://podadj.it';
const currentPath = Astro.url.pathname;
const itUrl = new URL(switchLocalePath(currentPath, 'it'), siteBase).href;
const enUrl = new URL(switchLocalePath(currentPath, 'en'), siteBase).href;
const canonicalUrl = new URL(currentPath, siteBase).href;
const ogImageUrl = new URL('/assets/bg-page.jpg', siteBase).href;
---

<!DOCTYPE html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <!-- i18n alternates for SEO -->
        <link rel="alternate" hreflang="it" href={itUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={itUrl} />
      </>
    )}

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/logo.png" />

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- FontAwesome 6 per le icone -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body class="antialiased flex flex-col items-center py-6 md:py-8 px-4 sm:px-6">
    <div class="w-full max-w-6xl flex flex-col items-center">
      <slot />
    </div>
  </body>
</html>
