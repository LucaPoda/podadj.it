# Autenticazione Portale Admin (/admin)
# Imposta entrambe le variabili in locale (.env) e nelle Environment Variables di Vercel.
# Non usare mai valori deboli o di default in produzione.

ADMIN_PASSWORD=change-me-with-a-strong-admin-password
SESSION_SECRET=change-me-with-at-least-32-random-hex-characters

# Integrazione GitHub REST & Git Data API (Fase 2+)
# Fine-grained PAT con permessi: Contents (Read & Write), Pull requests (Read & Write)
GITHUB_TOKEN=github_pat_replace_me
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=podadj.it
GITHUB_BASE_BRANCH=main

# Spotify Web API (Fase 3 - ricerca preview & link originali)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
