{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/mainstage-side", "destination": "/wip/mainstage-side", "permanent": false },
    { "source": "/party-side", "destination": "/wip/party-side", "permanent": false },
    { "source": "/groove-side", "destination": "/wip/groove-side", "permanent": false },
    { "source": "/tech-side", "destination": "/wip/tech-side", "permanent": false },
    { "source": "/demo-live-sets", "destination": "/wip/demo-live-sets", "permanent": false },
    { "source": "/events", "destination": "/wip/events", "permanent": false },
    { "source": "/partyhive", "destination": "/wip/partyhive", "permanent": false },
    { "source": "/en/mainstage-side", "destination": "/en/wip/mainstage-side", "permanent": false },
    { "source": "/en/party-side", "destination": "/en/wip/party-side", "permanent": false },
    { "source": "/en/groove-side", "destination": "/en/wip/groove-side", "permanent": false },
    { "source": "/en/tech-side", "destination": "/en/wip/tech-side", "permanent": false },
    { "source": "/en/demo-live-sets", "destination": "/en/wip/demo-live-sets", "permanent": false },
    { "source": "/en/events", "destination": "/en/wip/events", "permanent": false },
    { "source": "/en/partyhive", "destination": "/en/wip/partyhive", "permanent": false },
    { "source": "/admin", "destination": "/", "permanent": false },
    { "source": "/admin/(.*)", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/wip/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/en/wip/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
